# Generate with: mix phx.gen.secret
SECRET_KEY_BASE=

# Postgres password (choose something strong)
POSTGRES_PASSWORD=

# Optional overrides
PHX_HOST=antisocial.rprxy.mdma.sh
IDLE_LOCK_MINUTES=10

# Comma-separated alias hostnames that redirect to PHX_HOST (301)
# E.g. marielle.mdma.sh,chat.mdma.sh
ALIAS_HOSTS=marielle.mdma.sh
